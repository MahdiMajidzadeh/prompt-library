# Copy this file to .deploy.env (gitignored) and fill in the values.
# Used by deploy.sh.

FTP_HOST=ftp.your-server.com
FTP_PORT=21
FTP_USER=your-ftp-username
FTP_PASS=your-ftp-password

# Remote path that maps to the app root. The web server should be
# configured to serve ${FTP_REMOTE_DIR}/public as the document root.
FTP_REMOTE_DIR=/var/www/prompt-library

# Set to "no" if the server doesn't speak FTPS (AUTH TLS). Default "yes".
FTP_SSL_ALLOW=yes

# Set to "yes" to enforce certificate verification. Default "no" — many
# shared hosts use self-signed certs.
FTP_VERIFY_CERT=no
